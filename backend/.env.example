# OpenRouter / LLM Config
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
GUARD_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Razorpay Test Mode Keys (Get from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourKeySecret

# Gateway Invariant Defaults
MAX_SESSION_SPEND_INR=10000
MAX_DAILY_SPEND_INR=250000
MAX_AUTONOMOUS_TRANSACTION_INR=2000
AUDIT_HMAC_SECRET=replace_with_a_long_random_secret
ALLOWED_CURRENCY=INR
ALLOWED_ORIGINS=["http://localhost:5173"]
DATABASE_PATH=audit_vault.db